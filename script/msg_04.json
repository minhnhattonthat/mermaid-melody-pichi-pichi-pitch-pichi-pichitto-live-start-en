  "status": "",
  "notes": ""
 },
 {
  "id": "3875",
  "ids": [
   1400
  ],
  "used": true,
  "jp": "{FA:FF0101}まったく、{call:@2A5B}のやつったら…。\n{FA:FF0100}{end}",
