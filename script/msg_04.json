 },
 {
  "id": "3890",
  "ids": [
   1401
  ],
  "used": true,
  "jp": "{FA:FF0101}メイクのとちゅう、石橋は\nてをとめてしまった。{FA:06}なんでも、むかしのかのじょに、\nわたしがにているらしい。{wait}ほかのだれでもない、わたしは\nわたしだ。{FA:06}むかしのことばかりかんがえて、\nいまをみうしなっているやつに、\nようはない。{wait}………いや、むかしのことばかり\nかんがえているのは、じつは、\nじぶんなのかもしれないな……。\n{FA:FF0100}{end}",
  "en": "",
  "status": "",
  "notes": ""
 },
 {
  "id": "393C",
  "ids": [
   1291
  ],
  "used": true,
  "jp": "{FA:FF0101}{call:@2BAB}{wait}きょうはまちにまった、りんかい\nがっこう！{FA:06}なんでもこのしまには、どんなねが\nいごとでも１つだけかなうっていう\nたからもの「ねがいのゆびわ」が、\nあるらしいの！\n{FA:FF0100}{end}",
